rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Super admin role is set directly on the Firestore user doc (role: "super_admin").
    // No email is hardcoded here — grant access via the Firestore console.
    function isSuperAdmin() {
      return isAuth() && getUserData().role == 'super_admin';
    }

    // True when the signed-in user is an admin/owner of the given society.
    // Do NOT call this during society-creation bootstrap (societyId not yet set on profile).
    function isAdminOfSociety(societyId) {
      let u = getUserData();
      return u.role in ['admin', 'super_admin'] && u.societyId == societyId;
    }

    function isFollowCountUpdate(societyId) {
      let followPath = /databases/$(database)/documents/follows/$(request.auth.uid + '_' + societyId);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount'])
        && request.resource.data.followerCount is int
        && (
          (!exists(followPath)
            && existsAfter(followPath)
            && getAfter(followPath).data.followerId == request.auth.uid
            && getAfter(followPath).data.societyId == societyId
            && request.resource.data.followerCount == resource.data.followerCount + 1)
          ||
          (exists(followPath)
            && !existsAfter(followPath)
            && get(followPath).data.followerId == request.auth.uid
            && get(followPath).data.societyId == societyId
            && request.resource.data.followerCount == resource.data.followerCount - 1)
        );
    }

    // ─── Users ─────────────────────────────────────────────────────────────────

    match /users/{uid} {
      allow read:   if isAuth();
      allow create: if isAuth() && isOwner(uid);
      allow update: if isAuth() && (isOwner(uid) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // ─── Societies ─────────────────────────────────────────────────────────────

    match /societies/{societyId} {
      allow read:   if resource.data.privacy == 'public' || isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        isAdminOfSociety(societyId) ||
        isSuperAdmin() ||
        isFollowCountUpdate(societyId)
      );
      allow delete: if isSuperAdmin();
    }

    // ─── Members ───────────────────────────────────────────────────────────────

    match /members/{memberId} {
      allow read: if isAuth();
      // Bootstrap: creator writes their own member doc (role: owner) before
      // their profile has a societyId — isAdminOfSociety() would fail here.
      allow create: if isAuth() && (
        isAdminOfSociety(request.resource.data.societyId) ||
        (request.resource.data.role == 'owner' && request.resource.data.userId == request.auth.uid) ||
        isSuperAdmin()
      );
      allow update: if isAuth() && (isAdminOfSociety(resource.data.societyId) || isSuperAdmin());
      allow delete: if isAuth() && (isAdminOfSociety(resource.data.societyId) || isSuperAdmin());
    }

    // ─── Invitations ───────────────────────────────────────────────────────────

    match /invitations/{invId} {
      allow read:   if isAuth();
      allow create: if isAuth() && (isAdminOfSociety(request.resource.data.societyId) || isSuperAdmin());
      allow update: if isAuth();
      allow delete: if isAuth() && (isAdminOfSociety(resource.data.societyId) || isSuperAdmin());
    }

    // ─── Posts ─────────────────────────────────────────────────────────────────

    match /posts/{postId} {
      allow read:   if resource.data.visibility == 'public' || isAuth();
      allow create: if isAuth() && (isAdminOfSociety(request.resource.data.societyId) || isSuperAdmin());
      allow update: if isAuth() && (
        isAdminOfSociety(resource.data.societyId) ||
        isSuperAdmin() ||
        // Any auth user may toggle their own like (only these fields allowed)
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likeCount', 'likedBy', 'commentCount'])
      );
      allow delete: if isSuperAdmin() || (isAuth() && isAdminOfSociety(resource.data.societyId));

      match /comments/{commentId} {
        allow read:   if true;
        allow create: if isAuth();
        allow update: if isAuth() && isOwner(resource.data.authorId);
        allow delete: if isAuth() && (
          isOwner(resource.data.authorId) ||
          isAdminOfSociety(get(/databases/$(database)/documents/posts/$(postId)).data.societyId) ||
          isSuperAdmin()
        );
      }
    }

    // ─── Follows ───────────────────────────────────────────────────────────────

    match /follows/{followId} {
      allow read:   if isAuth();
      allow create: if isAuth() && isOwner(request.resource.data.followerId);
      allow delete: if isAuth() && (isOwner(resource.data.followerId) || isSuperAdmin());
    }

    // ─── Groups ────────────────────────────────────────────────────────────────

    match /groups/{groupId} {
      allow read:   if isAuth();
      allow create: if isAuth() && (isAdminOfSociety(request.resource.data.societyId) || isSuperAdmin());
      allow update: if isAuth() && (isAdminOfSociety(resource.data.societyId) || isSuperAdmin());
      allow delete: if isAuth() && (isAdminOfSociety(resource.data.societyId) || isSuperAdmin());

      match /messages/{messageId} {
        allow read:   if isAuth();
        allow create: if isAuth();
        allow update: if isAuth() && isOwner(resource.data.senderId);
        allow delete: if isAuth() && (
          isOwner(resource.data.senderId) ||
          isAdminOfSociety(get(/databases/$(database)/documents/groups/$(groupId)).data.societyId) ||
          isSuperAdmin()
        );
      }
    }

    // ─── Notifications ─────────────────────────────────────────────────────────

    match /notifications/{notifId} {
      allow read:   if isAuth() && (isOwner(resource.data.userId) || isSuperAdmin());
      allow create: if isAuth();
      allow update: if isAuth() && (isOwner(resource.data.userId) || isSuperAdmin());
      allow delete: if isAuth() && (isOwner(resource.data.userId) || isSuperAdmin());
    }

  }
}
