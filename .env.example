# ─────────────────────────────────────────────────────────────────────────────
# EduGlobe — Environment Variables Reference
# Copy this file to .env.local for local development.
# Add these as Environment Variables in your Vercel project dashboard:
#   https://vercel.com/[your-team]/eduglobe/settings/environment-variables
# ─────────────────────────────────────────────────────────────────────────────

# ─── Gemini AI ───────────────────────────────────────────────────────────────
# Required for AI features (EduGlobe Assistant).
# Get your key at: https://aistudio.google.com/apikey
EDU_AI_KEY="YOUR_GEMINI_API_KEY"

# ─── App URL ─────────────────────────────────────────────────────────────────
# The public URL where the app is hosted.
# For local dev: http://localhost:3000
# For Vercel: Vercel sets VERCEL_URL automatically, but set this explicitly
#             for OAuth callbacks and self-referential links.
# Example: https://eduglobe.vercel.app
APP_URL="https://your-deployment-url.vercel.app"

# ─── Notes ───────────────────────────────────────────────────────────────────
# Firebase config (projectId, apiKey, etc.) is stored in:
#   firebase-applet-config.json  ← committed to repo (safe, public config)
# No Firebase env vars are needed separately.
